{
    "mcpServers": {
        "fetch": {
            "command": "uvx",
            "args": [
                "mcp-server-fetch"
            ],
            "env": {
                "UV_INDEX_URL": "https://pypi.tuna.tsinghua.edu.cn/simple"
            },
            "disabled": false
        },
        "serper_web_search": {
            "sse_url": "http://127.0.0.1:34011/sse",
            "disabled": false
        },
        "baidu-map": {
            "command": "npx",
            "args": [
                "-y",
                "@baidumap/mcp-server-baidu-map"
            ],
            "env": {
                "BAIDU_MAP_API_KEY": "${BAIDU_MAP_API_KEY}"
            },
            "disabled": false,
            "description": "查询地点、坐标、距离和路线建议。"
        },
        "12306-mcp": {
            "command": "npx",
            "args": [
                "-y",
                "12306-mcp"
            ],
            "disabled": false,
            "description": "查询中国铁路车次、余票和中转方案。"
        },
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "./outputs"
            ],
            "disabled": false,
            "description": "在旅行输出目录中读取和保存文件。"
        },
        "xhs-mcp": {
            "command": "python",
            "args": [
                "mcp_servers/xhs-mcp/main.py"
            ],
            "env": {
                "XHS_COOKIE": "${XHS_COOKIE}",
                "SERPER_API_KEY": "${SERPER_API_KEY}"
            },
            "disabled": false,
            "description": "检索与目的地旅行主题相关的小红书公开内容。"
        },
        "unsplash-mcp": {
            "command": "python",
            "args": ["mcp_servers/unsplash-mcp/main.py"],
            "env": {
                "UNSPLASH_ACCESS_KEY": "${UNSPLASH_ACCESS_KEY}",
                "UNSPLASH_APP_NAME": "${UNSPLASH_APP_NAME}"
            },
            "disabled": false,
            "description": "搜索并提供带版权署名的旅行图片。"
        }
    }
}
