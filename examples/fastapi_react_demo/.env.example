# Core model runtime
SAGE_API_KEY=your-api-key-here
SAGE_MODEL_NAME=qwen3-max-2026-01-23
SAGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SAGE_MAX_TOKENS=4096
SAGE_TEMPERATURE=0.7

# Server runtime
SAGE_HOST=0.0.0.0
SAGE_PORT=8001
SAGE_DEBUG=false
SAGE_ENVIRONMENT=development

# Local output root (project-level)
SAGE_OUTPUT_ROOT=./outputs

# Optional external tool secrets
BAIDU_MAP_API_KEY=your-baidu-map-api-key-here
AMAP_MAPS_API_KEY=your-amap-web-service-api-key-here
BAIDU_MAP_MIN_INTERVAL_SECONDS=2
BAIDU_MAP_COOLDOWN_INTERVAL_SECONDS=5
BAIDU_MAP_NETWORK_TIMEOUT_SECONDS=35
BAIDU_MAP_QUEUE_TIMEOUT_SECONDS=300
XHS_COOKIE=your-xhs-cookie-here
SERPER_API_KEY=your-serper-api-key-here
TAVILY_API_KEY=tvly-your-tavily-api-key-here
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
UNSPLASH_APP_NAME=SuperTravelAgent
TRAVEL_WEB_IMAGE_SEARCH_LIMIT=28
# 国际餐厅使用单次、带缓存的 OpenStreetMap Nominatim 用户触发查询；可切换为自建实例。
OSM_RESTAURANT_SEARCH_ENABLED=true
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_TIMEOUT_SECONDS=20
# 国际预算使用欧洲央行带日期的每日参考汇率交叉换算，仅作 CNY 参考。
ECB_EXCHANGE_RATE_ENABLED=true
ECB_EXCHANGE_RATE_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
ECB_EXCHANGE_RATE_TIMEOUT_SECONDS=15
# 真实 Provider 会启动持久 MCP 子进程；默认关闭热重载，避免重载父进程残留 Provider 与端口抖动。
SAGE_RELOAD=false
